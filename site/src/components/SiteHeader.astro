---
import {
  GITHUB_REPO_URL,
  PRIMARY_NAV_ITEMS,
  isNavSectionActive,
  withBase,
} from '../lib/routes.ts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="brand-group">
      <button
        type="button"
        class="menu-btn chamfer-sm"
        command="show-modal"
        commandfor="mobile-nav-drawer"
        aria-controls="mobile-nav-drawer"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span aria-hidden="true">☰</span>
        <span>Menu</span>
      </button>

      <a
        href={withBase('/')}
        class="slab-logo chamfer-sm"
        aria-current={isNavSectionActive(currentPath, '/') ? 'page' : undefined}
      >
        ENV / SKEW
      </a>
      <span class="slab-rev">6 HP · REV 1.0</span>
    </div>

    <nav class="primary-nav" aria-label="Primary">
      {
        PRIMARY_NAV_ITEMS.map((item) => (
          <a
            href={withBase(item.href)}
            class="nav-link"
            aria-current={isNavSectionActive(currentPath, item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <slot name="search-trigger">
        <button
          type="button"
          class="header-action-btn"
          data-search-trigger
          aria-label="Search site"
        >
          <span aria-hidden="true">⌕</span>
          <span>Search</span>
          <kbd class="search-kbd-hint">⌘K</kbd>
        </button>
      </slot>

      <a
        href={GITHUB_REPO_URL}
        class="header-action-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <svg class="github-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span class="action-label-github">GitHub</span>
      </a>
    </div>
  </div>
</header>

<dialog id="mobile-nav-drawer" class="nav-drawer" closedby="any" aria-labelledby="mobile-nav-title">
  <div class="nav-drawer-head">
    <h1 id="mobile-nav-title" class="nav-drawer-title">ENV / SKEW</h1>
    <form method="dialog">
      <button type="submit" class="nav-drawer-close" autofocus aria-label="Close navigation menu">
        Close
      </button>
    </form>
  </div>
  <nav aria-label="Mobile navigation">
    <ul class="nav-drawer-links">
      <li>
        <a
          href={withBase('/')}
          class="nav-drawer-link"
          aria-current={isNavSectionActive(currentPath, '/') ? 'page' : undefined}
        >
          <span>Overview</span>
          <span class="mono">00</span>
        </a>
      </li>
      {
        PRIMARY_NAV_ITEMS.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              class="nav-drawer-link"
              aria-current={isNavSectionActive(currentPath, item.href) ? 'page' : undefined}
            >
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={withBase('/specs/')}
          class="nav-drawer-link"
          aria-current={isNavSectionActive(currentPath, '/specs/') ? 'page' : undefined}
        >
          <span>Reference Specs</span>
        </a>
      </li>
      <li>
        <a
          href={GITHUB_REPO_URL}
          class="nav-drawer-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>GitHub Repository</span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </nav>
</dialog>

<script>
  import { initDialogChrome } from '../lib/dialog-chrome.ts';

  initDialogChrome();
</script>
