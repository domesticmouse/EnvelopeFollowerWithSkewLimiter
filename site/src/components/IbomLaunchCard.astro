---
import { getRepoFileSizeLabel } from '../lib/repo-files.ts';
import { withBase } from '../lib/routes.ts';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const fileSize = getRepoFileSizeLabel('bom/ibom.html');
const ibomHref = withBase('/bom/ibom.html');
---

<aside
  class:list={['ibom-launch-card', compact && 'ibom-launch-card-compact']}
  aria-label="Interactive Hand-Assembly BOM launcher"
  data-pagefind-ignore
>
  <div class="ibom-launch-body">
    <p class="ibom-kicker mono">bom/ibom.html · Dedicated Tab · {fileSize}</p>
    <h2 class="ibom-title">Interactive Hand-Assembly BOM &amp; Placement Map</h2>
    <p class="ibom-desc">
      Opens KiCad InteractiveHtmlBom pre-filtered strictly to the <code>18</code>{' '}
      <code>Manual THT</code> components (<code>14</code> BOM rows: <code>11</code> Front /{' '}
      <code>7</code> Back; excludes SMDs and DNP test points) with <code>F</code> / <code>B</code>{' '}
      board-side toggles, independent <strong>Sourced</strong> / <strong>Placed</strong> browser
      tracking, and gear-menu Dark Mode.
    </p>
  </div>

  <div class="ibom-launch-actions">
    <a
      href={ibomHref}
      target="_blank"
      rel="noopener noreferrer"
      data-ibom-link="true"
      class="ibom-launch-btn"
    >
      <span>Launch Interactive BOM</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</aside>
